# Python/runtime
__pycache__/
*.py[codz]
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage*
htmlcov/

# Secrets and local auth
.env
.env.*
*.env
.auth/
credentials.json
*.pem
*.key
.credentials

# Local databases and database sidecars (default ignore).
# Compact forecast SQLite under Output/ForecastAccuracy/ is promoted when under
# the ~90 MB multi-PC ceiling — see Docs/operations/forecast_accuracy/
# FORECAST_PORTABLE_ARTIFACTS_2026-06-17.md and AGENTS.md.
*.db
*.sqlite
*.db-shm
*.db-wal
*.db-journal
!Output/ForecastAccuracy/**/*.db
Output/ForecastAccuracy/promotions/promotions.db

# Excel lock/temp files. Source workbooks are trackable when under the 90 MB practical limit.
~$*.xlsx

# GitHub hard-stop / local-only large files. Prefer split Parquet parts when useful.
Output/ForecastAccuracy/model/model_sku_day_panel.parquet
Output/ForecastAccuracy/promotions/pdl_offer_rows.csv
Output/ForecastAccuracy/promotions/promotions.db
Source/Promotions/6.18.26 Hanna Sale PDL.xlsx
Source/Promotions/7.21.26 BTS & Sleep Up to 30% Off + New Markdowns.xlsm

# Generated environments/caches/logs
*.log
tmp/

# Keep forecast artifacts trackable by default, including Parquet/CSV/JSON/MD outputs,
# as long as individual files remain below the practical 90 MB push ceiling.

# Producer-owned monitoring detail shards are mirrored locally for rebuilds.
# Track the consolidated forecast facts and metadata instead of these duplicates.
Output/ForecastAccuracy/inbound/ax_open_inbound_detail_20*.parquet
Output/ForecastAccuracy/inventory/pickface_inventory_snapshot_detail_20*.parquet

